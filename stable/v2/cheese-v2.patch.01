+    private static void collectIncentives(String text, List<BigDecimal> values) {
+        boolean found = false;
+        Matcher before = INCENTIVE_BEFORE.matcher(text);
+        while (before.find()) {
+            values.add(new BigDecimal(before.group(1)));
+            found = true;
+        }
+        if (!found) {
+            Matcher after = INCENTIVE_AFTER.matcher(text);
+            while (after.find()) values.add(new BigDecimal(after.group(1)));
+        }
+    }
