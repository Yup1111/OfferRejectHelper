--- cheese_base/SparkRejectHelper/app/src/main/java/com/local/sparkreject/GifBackgroundView.java	2026-10-01 05:24:16.000000000 +0000
+++ cheese_fix/SparkRejectHelper/app/src/main/java/com/local/sparkreject/GifBackgroundView.java	2026-10-01 18:35:17.930586651 +0000
@@ -25,19 +25,22 @@
 
     @Override protected void onDraw(Canvas canvas) {
         super.onDraw(canvas);
-        if (movie == null || movie.width() <= 0 || movie.height() <= 0) {
-            canvas.drawColor(0xFF111111);
-            return;
-        }
+        // Fill unused space with a dark cheese/brown backdrop instead of zooming the GIF until it is unrecognizable.
+        canvas.drawColor(0xFF160D07);
+        if (movie == null || movie.width() <= 0 || movie.height() <= 0) return;
+
         int duration = movie.duration();
         if (duration <= 0) duration = 1000;
         movie.setTime((int) ((SystemClock.uptimeMillis() - started) % duration));
 
-        float sx = getWidth() / (float) movie.width();
-        float sy = getHeight() / (float) movie.height();
-        float scale = Math.max(sx, sy); // center-crop, never stretch
+        // Preserve the GIF's full composition and aspect ratio. Never crop or stretch it.
+        // The source GIF is only 160x85, so cap enlargement at 3x to prevent the giant pixelated look.
+        float fit = Math.min(getWidth() / (float) movie.width(), getHeight() / (float) movie.height());
+        float scale = Math.min(fit, 3.0f);
+        if (scale <= 0f) scale = 1f;
         float dx = (getWidth() - movie.width() * scale) / 2f;
         float dy = (getHeight() - movie.height() * scale) / 2f;
+
         canvas.save();
         canvas.translate(dx, dy);
         canvas.scale(scale, scale);
