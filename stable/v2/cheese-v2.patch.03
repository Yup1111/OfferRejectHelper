diff -ruN '--exclude=.gradle' '--exclude=build' '--exclude=ic_launcher_art.webp' cheese_base/SparkRejectHelper/checks/DecisionCheck.java cheese_fix/SparkRejectHelper/checks/DecisionCheck.java
--- cheese_base/SparkRejectHelper/checks/DecisionCheck.java	2026-09-24 18:10:36.000000000 +0000
+++ cheese_fix/SparkRejectHelper/checks/DecisionCheck.java	2026-10-01 18:36:43.512162514 +0000
@@ -7,6 +7,10 @@
         Decision actual = Decision.evaluate(List.of(fields), new BigDecimal("2.00"));
         if (actual.result != expected) throw new AssertionError(expected + " but got " + actual.result + ": " + actual.explanation);
     }
+    private static void eq(String expected, BigDecimal actual, String label) {
+        if (actual == null || new BigDecimal(expected).compareTo(actual) != 0)
+            throw new AssertionError(label + " expected " + expected + " but got " + actual);
+    }
     public static void main(String[] args) {
         check(Decision.Result.REJECT, "Estimated earnings", "$15.00", "Trip distance", "10 mi", "Reject");
         check(Decision.Result.KEEP, "Estimated earnings $22.00", "Total distance 11 miles");
@@ -24,8 +28,34 @@
         check(Decision.Result.REJECT, "$19.00", "3 stops", "• 10.5 miles • 40 mins");
         check(Decision.Result.UNKNOWN, "$23.41", "3 stops", "• 10.5 miles • 40 mins", "Pickup 2 miles away");
         check(Decision.Result.UNKNOWN, "$23.41", "3 stops", "Trip distance 10.5 miles", "Other distance 12 miles");
+
         Decision sample = Decision.evaluate(List.of("$23.41", "$10 estimated tip", "3 stops", "• 10.5 miles • 40 mins"), new BigDecimal("2"));
-        if (!new BigDecimal("10.5").equals(sample.miles) || !new BigDecimal("2.23").equals(sample.perMile)) throw new AssertionError("Incorrect mileage/rate");
+        eq("10.5", sample.miles, "miles");
+        eq("2.23", sample.perMile, "rate without incentive");
+
+        // Exact behavior requested from the Spark screenshot: displayed offer $27.80 + $5 incentive = $32.80 for $/mile.
+        Decision incentive = Decision.evaluate(List.of(
+                "$27.80", "Total includes", "$8 estimated tip", "$5 incentive", "1 point",
+                "3 stops • 10.5 miles • 1hr, 3 mins", "Sam's Club #8291", "REJECT", "ACCEPT"), new BigDecimal("3.00"));
+        eq("27.80", incentive.pay, "displayed pay");
+        eq("5", incentive.incentivePay, "incentive");
+        eq("32.80", incentive.effectivePerMilePay, "effective per-mile pay");
+        eq("3.12", incentive.perMile, "incentive-adjusted rate");
+        if (incentive.result != Decision.Result.KEEP) throw new AssertionError("$32.80/10.5 should clear $3/mi");
+
+        // Do not accidentally count tip as incentive when text is combined in one accessibility field.
+        Decision combined = Decision.evaluate(List.of(
+                "$27.80", "Total includes $8 estimated tip, $5 incentive", "3 stops • 10.5 miles"), new BigDecimal("3"));
+        eq("5", combined.incentivePay, "combined incentive line");
+        eq("32.80", combined.effectivePerMilePay, "combined effective pay");
+
+        Decision multiple = Decision.evaluate(List.of(
+                "$20.00", "$5 incentive", "$2.50 incentive", "2 stops • 10 miles"), new BigDecimal("2.70"));
+        eq("7.50", multiple.incentivePay, "multiple incentives");
+        eq("27.50", multiple.effectivePerMilePay, "multiple-incentive pay");
+        eq("2.75", multiple.perMile, "multiple-incentive rate");
+        if (multiple.result != Decision.Result.KEEP) throw new AssertionError("Multiple incentives should be added");
+
         System.out.println("Decision checks passed");
     }
 }
